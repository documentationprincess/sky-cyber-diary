---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Documentation Princess',
  description = 'A cybersecurity diary by Sky.'
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f8f4eb" />
    <title>{title}</title>
    <link rel="icon" type="image/jpeg" href="/ui/docdocs-avatar.jpg" />
  </head>

  <body>
    <div class="browser-shell">
        <div class="fake-address">🔒 &nbsp; https://documentationprincess.vercel.app</div>
        <div class="browser-icons">☆ &nbsp; ☠</div>
      </div>

      <header class="site-header">
        <a class="brand" href="/">
          <span class="brand-icon">☠</span>
          <span>DOCUMENTATION PRINCESS</span>
        </a>

        <nav aria-label="Primary navigation">
          <a href="/#case-files">CASE FILES</a><i>/</i>
          <a href="/#hero">DIARY</a><i>/</i>
          <a href="/#about">ABOUT</a><i>/</i>
          <a href="/#mission">TOOLS</a><i>/</i>
          <a href="https://github.com/documentationprincess" rel="noreferrer">GITHUB ↗</a>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="terminal-footer">
        <img
          src="/ui/nurse.png"
          alt=""
          width="170"
          height="125"
          aria-hidden="true"
        />
        <span>&gt; documentation is self care.exe</span>
        <span class="online">▮▮▮▮▯ &nbsp; online &nbsp; ☠</span>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --paper: #fffaf5;
    --ink: #101010;
    --pink: #ef99c8;
    --pink-soft: #ffd9ea;
    --pink-hot: #e34395;
    --orange: #ff8a24;
    --green: #d8ff75;
    --lavender: #e9c8f4;
    --grid: rgba(35, 32, 28, .055);
    color: var(--ink);
    background: #f4f0e7;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }

  body {
    margin: 0;
    min-height: 100vh;
    overflow-x: hidden;
    background:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px),
      #f4f0e7;
    background-size: 2vw 2vw;
  }

  a { color: inherit; }
  img { display: block; max-width: 100%; }

  /*
   * Important: NO fixed 1100px max-width.
   * The approved mockup is a full-viewport composition.
   * vw sizing means it remains proportionally the same even when the browser is zoomed out.
   */
  .browser-shell {
    width: 100%;
    margin: 0;
    background: var(--paper);
    overflow: hidden;
  }

  .browser-controls,

  .site-header {
    height: 5.5vw;
    min-height: 64px;
    padding: 0 2.6vw;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5vw;
    background: #080809;
    color: #ffd8ef;
    border-bottom: .15vw solid var(--pink-hot);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: .75vw;
    color: inherit;
    text-decoration: none;
    font-size: 1.3vw;
    font-weight: 900;
    letter-spacing: .02em;
    white-space: nowrap;
  }

  .brand-icon { color: var(--green); }

  nav {
    display: flex;
    align-items: center;
    gap: .8vw;
    font-size: 1vw;
    font-weight: 900;
    white-space: nowrap;
  }

  nav a { text-decoration: none; }
  nav a:hover { color: var(--green); }
  nav i { color: #9b6e89; font-style: normal; }

  main { background: var(--paper); }

  .terminal-footer {
    height: 6.7vw;
    margin: 0 1.25vw 1.25vw;
    padding: 0 1.4vw 0 15vw;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5vw;
    background: #050607;
    color: #89ffc0;
    border: .14vw solid #2e2340;
    border-radius: .85vw;
    box-shadow: 0 0 0 .2vw #d7caf4;
    font-size: .95vw;
  }

  .terminal-footer img {
    position: absolute;
    left: 1.6vw;
    bottom: -.05vw;
    width: 12.8vw !important;
    height: 9.1vw !important;
    max-width: 12.8vw !important;
    object-fit: contain;
    object-position: bottom;
  }

  .online { color: #c9ff7a; }

  @media (max-width: 760px) {
    body { background-size: 28px 28px; }

    .browser-chrome,

    .site-header {
      min-height: 58px;
      height: auto;
      padding: 10px 13px;
      align-items: flex-start;
      flex-direction: column;
    }

    .brand { font-size: 14px; }

    nav {
      width: 100%;
      gap: 10px;
      overflow-x: auto;
      padding-bottom: 3px;
      font-size: 11px;
    }

    .terminal-footer {
      min-height: 64px;
      height: auto;
      margin: 0 12px 12px;
      padding: 12px 14px;
      font-size: 11px;
    }

    .terminal-footer img { display: none; }
    .online { display: none; }
  }
</style>
