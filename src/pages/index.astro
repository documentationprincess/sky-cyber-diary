---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('posts'))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);

const thumbFor = (caseNumber: string) => {
  if (caseNumber === '003') return '/ui/case-linux.png';
  if (caseNumber === '002') return '/ui/case-wazuh.png';
  return '/ui/case-windows.png';
};
---
<BaseLayout
  title="Documentation Princess"
  description="Real labs, real failures, real documentation."
  showHeader={false}
>
  <section id="hero" class="hero">
    <div class="avatar-column">
      <div class="avatar-grid" aria-hidden="true"></div>

      <div class="note-bubble">
        still<br />figuring<br />it out...
      </div>

      <div class="avatar-ring">
        <img
          src="/ui/docdocs-avatar.jpg?v=20260822c"
          alt="Documentation Princess avatar"
        />
      </div>
    </div>

    <div class="hero-center">
      <div class="name-row">
        <h1>sky blu degrate</h1>
        <span class="sparkle" aria-hidden="true">✦</span>
      </div>

      <div class="role-strip">
        IT SUPPORT <b>|</b> CYBERSECURITY <b>|</b> CHAOS COORDINATOR_
      </div>

      <p class="hero-tagline">
        real labs. <em>real failures.</em> real documentation.
      </p>

      <p class="location">
        <span aria-hidden="true">●</span> NYC / BROOKLYN
      </p>
    </div>

    <aside class="status-card" aria-label="Current status">
      <div class="status-prompt">&gt;_</div>
      <p><span>+</span> <strong>professionally<br />suspicious</strong></p>
      <p><span>+</span> threat hunter<br />in training</p>
      <p><span>+</span> documenting<br />the chaos</p>
      <div class="status-skull" aria-hidden="true">☠</div>
    </aside>
  </section>

  <nav class="home-nav" aria-label="Homepage navigation">
    <div class="home-nav-links">
      <a class="active" href="/#case-files">/ CASE FILES</a>
      <a href="/about">/ ABOUT</a>
      <a href="https://github.com/documentationprincess" rel="noreferrer">/ GITHUB ↗</a>
      <a href="https://www.linkedin.com/in/skydegrate/" rel="noreferrer">/ LINKEDIN ↗</a>
      <a href="mailto:skybludegrate.cybersec@gmail.com">/ CONTACT</a>
    </div>

    <div class="home-nav-status" aria-hidden="true">
      <span>●</span> online
    </div>
  </nav>

  <section class="dashboard">
    <section id="case-files" class="window cases-window">
      <header class="window-title">
        <span>▱ &nbsp;/latest - case files ✧</span>
        <span>— □ ×</span>
      </header>

      <p class="window-subtitle">
        real labs. <em>real failures.</em> real documentation.
      </p>

      <div class="case-list">
        {posts.map((post) => (
          <a class="case-card" href={`/case-files/${post.id}/`}>
            <img src={thumbFor(post.data.caseNumber)} alt="" />

            <div class="case-body">
              <div class="case-top">
                <div class="tags">
                  {post.data.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}
                </div>

                <time datetime={post.data.publishedAt.toISOString()}>
                  {post.data.publishedAt.toLocaleDateString('en-US', {
                    month: 'short',
                    day: '2-digit',
                    year: 'numeric'
                  })}
                </time>
              </div>

              <h2>
                Case File #{post.data.caseNumber}:<br />
                {post.data.title}
              </h2>

              <p>{post.data.description}</p>
              <span class="case-arrow">→</span>
            </div>
          </a>
        ))}
      </div>

      <a class="view-all" href="/#case-files">
        &gt; view all case files &nbsp;▱
      </a>
    </section>

    <aside class="sidebar">
      <section id="about" class="window about-window">
        <header class="window-title lavender">
          <span>✦ /about.exe</span>
          <span>— □ ×</span>
        </header>

        <div class="about-grid">
          <img src="/ui/about-sky.png?v=20260822c" alt="Sky" />

          <p>
            IT support by day,<br />
            threat hunter in<br />
            training by night.
            <br /><br />
            documenting the chaos so future me (or a recruiter) doesn’t have to ask.
          </p>
        </div>

        <a class="panel-link" href="/about">
          &gt; more about me <span>→</span>
        </a>
      </section>

      <section id="mission" class="window mission-window">
        <header class="window-title pink">
          <span>✦ /current mission</span>
          <span>— □ ×</span>
        </header>

        <div class="mission-terminal">
          <p>&gt; build skills</p>
          <p>&gt; help people</p>
          <p>&gt; find bugs, not people <span class="cursor">▮</span></p>
        </div>
      </section>

      <section class="window connect-window">
        <header class="window-title green">
          <span>&gt; connect</span>
        </header>

        <div class="connect-links">
          <a href="https://github.com/documentationprincess" rel="noreferrer">
            <span class="connect-label">
              <span class="connect-icon">◉</span>
              <span>GitHub</span>
            </span>
            <b>↗</b>
          </a>

          <a href="https://www.linkedin.com/in/skydegrate/" rel="noreferrer">
            <span class="connect-label">
              <span class="connect-icon linkedin-icon">in</span>
              <span>LinkedIn</span>
            </span>
            <b>↗</b>
          </a>

          <a href="mailto:skybludegrate.cybersec@gmail.com">
            <span class="connect-label">
              <span class="connect-icon">✉</span>
              <span>Email</span>
            </span>
            <b>↗</b>
          </a>
        </div>
      </section>
    </aside>
  </section>
</BaseLayout>

<style>
  .hero {
    min-height: 31vw;
    padding: 2.4vw 3vw 2vw 4.2vw;
    display: grid;
    grid-template-columns: 28vw minmax(0, 1fr) 15vw;
    gap: 2.8vw;
    align-items: center;
    background: #fffaf7;
    border-bottom: .08vw solid #e8dfe1;
  }

  .avatar-column {
    position: relative;
    width: 27vw;
    height: 27vw;
    display: grid;
    place-items: center;
  }

  .avatar-grid {
    position: absolute;
    inset: -1.8vw -1.2vw -1.3vw -1.1vw;
    opacity: .8;
    background:
      linear-gradient(rgba(237, 100, 171, .18) 1px, transparent 1px),
      linear-gradient(90deg, rgba(237, 100, 171, .18) 1px, transparent 1px);
    background-size: 1.15vw 1.15vw;
    mask-image: linear-gradient(to right, #000 0 78%, transparent 100%);
  }

  .avatar-ring {
    position: relative;
    z-index: 1;
    width: 24vw;
    height: 24vw;
    overflow: hidden;
    border: .18vw solid #111;
    border-radius: 50%;
    background: #fff;
    box-shadow: .22vw .3vw 0 rgba(0, 0, 0, .08);
  }

  .avatar-ring img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .note-bubble {
    position: absolute;
    z-index: 3;
    left: -.5vw;
    top: -.7vw;
    padding: .75vw 1vw;
    border: .12vw solid #111;
    border-radius: .4vw;
    background: #0c0d0e;
    color: #96ff72;
    box-shadow: .23vw .23vw 0 rgba(0, 0, 0, .1);
    font-size: .82vw;
    font-weight: 800;
    line-height: 1.25;
  }

  .note-bubble::after {
    content: "";
    position: absolute;
    left: 2.4vw;
    bottom: -.58vw;
    width: 1vw;
    height: 1vw;
    background: #0c0d0e;
    border-right: .12vw solid #111;
    border-bottom: .12vw solid #111;
    transform: rotate(45deg);
  }

  .hero-center {
    min-width: 0;
    align-self: center;
  }

  .name-row {
    display: flex;
    align-items: flex-start;
    gap: 1vw;
  }

  h1 {
    margin: 0 0 1.6vw;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 6.2vw;
    line-height: .9;
    letter-spacing: -.065em;
    text-transform: lowercase;
    white-space: nowrap;
  }

  .sparkle {
    margin-top: -.3vw;
    color: #e64095;
    font-size: 2.7vw;
    line-height: 1;
  }

  .role-strip {
    display: inline-block;
    max-width: 100%;
    padding: .95vw 1.25vw;
    background: #08090a;
    color: #fff;
    font-size: 1.05vw;
    font-weight: 900;
    line-height: 1;
    letter-spacing: .01em;
    white-space: nowrap;
  }

  .role-strip b {
    padding: 0 .72vw;
    color: #e74097;
  }

  .hero-tagline {
    margin: 1.8vw 0 0;
    font-size: 1.2vw;
    line-height: 1.4;
  }

  .hero-tagline em {
    color: #e43e94;
    font-style: normal;
  }

  .location {
    margin: 1.45vw 0 0;
    font-size: 1.05vw;
    font-weight: 800;
  }

  .location span {
    margin-right: .6vw;
    color: #e43e94;
  }

  .status-card {
    align-self: center;
    min-height: 15.5vw;
    padding: 1.2vw 1.25vw;
    border: .1vw dashed #7d7d7d;
    border-radius: .5vw;
    background: rgba(255, 255, 255, .5);
    box-shadow: .25vw .3vw 0 rgba(0, 0, 0, .03);
    font-size: .88vw;
    line-height: 1.28;
  }

  .status-prompt {
    margin-bottom: 1vw;
    font-size: 1.35vw;
    font-weight: 900;
  }

  .status-card p {
    display: grid;
    grid-template-columns: 1.2em 1fr;
    gap: .3vw;
    margin: .75vw 0;
  }

  .status-card p > span {
    font-weight: 900;
  }

  .status-card strong {
    color: #63bb45;
    font-weight: 900;
  }

  .status-skull {
    margin-top: 1vw;
    color: #e43e94;
    text-align: center;
    font-size: 1.35vw;
  }

  .home-nav {
    min-height: 4.25vw;
    padding: 0 3.8vw;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2vw;
    background: #07090a;
    color: #f8f4f1;
    border-bottom: .08vw solid #232323;
  }

  .home-nav-links {
    display: flex;
    align-items: center;
    gap: 2.4vw;
    overflow-x: auto;
  }

  .home-nav a {
    flex: 0 0 auto;
    font-size: .85vw;
    font-weight: 800;
    text-decoration: none;
  }

  .home-nav a:hover,
  .home-nav .active {
    color: #f05ba6;
  }

  .home-nav-status {
    flex: 0 0 auto;
    color: #86f66c;
    font-size: .78vw;
  }

  .dashboard {
    padding: 2.1vw 2.7vw 3vw;
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(22vw, .95fr);
    gap: 1.9vw;
    align-items: start;
    background: #fffaf7;
  }

  .window {
    background: rgba(255, 253, 250, .98);
    border: .12vw solid #111;
    border-radius: .6vw;
    box-shadow: .25vw .28vw 0 rgba(17, 17, 17, .85);
    overflow: hidden;
  }

  .window-title {
    min-height: 3.35vw;
    padding: .68vw 1vw;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1vw;
    background: #fff;
    border-bottom: .1vw solid #111;
    font-size: 1.15vw;
    font-weight: 900;
  }

  .cases-window > .window-title {
    background: #fff;
  }

  .window-title.lavender {
    background: #f1dcf7;
  }

  .window-title.pink {
    background: #f3afd0;
  }

  .window-title.green {
    background: #d8ff75;
  }

  .window-subtitle {
    margin: 0;
    padding: 1.05vw 1.35vw .65vw;
    font-size: .98vw;
  }

  .window-subtitle em {
    color: #d13d88;
    font-style: normal;
  }

  .case-list {
    padding: .85vw 1vw .15vw;
  }

  .case-card {
    min-height: 15.8vw;
    padding: 1.2vw;
    display: grid;
    grid-template-columns: 15vw minmax(0, 1fr);
    gap: 1.35vw;
    border: .08vw solid #2b2b2b;
    border-radius: .55vw;
    margin-bottom: .8vw;
    background: #fff;
    color: inherit;
    text-decoration: none;
    transition: transform .13s ease, box-shadow .13s ease;
  }

  .case-card:hover {
    transform: translate(-.12vw, -.12vw);
    box-shadow: .28vw .28vw 0 #ef69ad;
  }

  .case-card > img {
    width: 15vw;
    height: 13.9vw;
    border-radius: .4vw;
    object-fit: cover;
    border: .08vw solid #111;
    background: #111;
  }

  .case-body {
    min-width: 0;
    position: relative;
    padding-bottom: 1.6vw;
  }

  .case-top {
    display: flex;
    justify-content: space-between;
    gap: .7vw;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: .4vw;
  }

  .tags span {
    padding: .28vw .55vw;
    background: #f8d9e9;
    border: .05vw solid #e9aacb;
    border-radius: 999px;
    font-size: .69vw;
    text-transform: uppercase;
  }

  time {
    font-size: .72vw;
    white-space: nowrap;
  }

  .case-card h2 {
    margin: .85vw 0 .55vw;
    font-size: 1.72vw;
    line-height: 1.02;
  }

  .case-card p {
    margin: 0;
    color: #3b3439;
    font-size: .98vw;
    line-height: 1.45;
    max-width: 70ch;
  }

  .case-arrow {
    position: absolute;
    right: 0;
    bottom: 0;
    font-size: 1.4vw;
  }

  .view-all {
    display: block;
    padding: .65vw 1.35vw 1.2vw;
    color: #cf3c8a;
    font-size: .95vw;
    font-weight: 900;
    text-decoration: none;
  }

  .sidebar {
    display: grid;
    gap: 1.15vw;
  }

  .about-grid {
    padding: 1.2vw;
    display: grid;
    grid-template-columns: 10.5vw 1fr;
    gap: 1.2vw;
  }

  .about-grid img {
    width: 10.5vw;
    height: 13.5vw;
    object-fit: cover;
    object-position: 50% 18%;
    border: .08vw solid #111;
    border-radius: .4vw;
  }

  .about-grid p {
    margin: 0;
    font-size: .94vw;
    line-height: 1.45;
  }

  .panel-link {
    display: flex;
    justify-content: space-between;
    padding: .3vw 1.2vw 1.1vw;
    font-size: .92vw;
    font-weight: 900;
  }

  .mission-terminal {
    margin: 1vw;
    padding: 1vw 1.2vw;
    background: #090b0c;
    color: #83f56b;
    border-radius: .35vw;
    font-size: .95vw;
    line-height: 1.45;
  }

  .mission-terminal p {
    margin: .15vw 0;
  }

  .cursor {
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  .connect-links {
    padding: .35vw 1vw .7vw;
  }

  .connect-links a {
    display: flex;
    justify-content: space-between;
    padding: .7vw 0;
    border-bottom: .05vw solid rgba(0, 0, 0, .15);
    font-size: .94vw;
    text-decoration: none;
  }

  .connect-links a:last-child {
    border-bottom: 0;
  }

  .connect-label {
    display: grid;
    grid-template-columns: 2.65em auto;
    align-items: center;
    column-gap: .35em;
  }

  .connect-icon {
    width: 2.65em;
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    font-weight: 900;
  }

  .linkedin-icon {
    font-family: Arial, Helvetica, sans-serif;
    font-weight: 900;
    letter-spacing: -.08em;
  }

  @media (max-width: 760px) {
    .hero {
      min-height: 0;
      padding: 42px 18px 34px;
      grid-template-columns: 1fr;
      gap: 24px;
      text-align: center;
    }

    .avatar-column {
      width: 250px;
      height: 250px;
      margin: 0 auto;
    }

    .avatar-grid {
      inset: -18px -12px -14px -10px;
      background-size: 12px 12px;
    }

    .avatar-ring {
      width: 225px;
      height: 225px;
      border-width: 2px;
    }

    .note-bubble {
      left: -4px;
      top: -10px;
      padding: 8px 10px;
      border-width: 1px;
      font-size: 11px;
    }

    .name-row {
      justify-content: center;
    }

    h1 {
      margin-bottom: 22px;
      font-size: clamp(3.6rem, 16vw, 5.8rem);
      white-space: normal;
    }

    .sparkle {
      font-size: 28px;
    }

    .role-strip {
      margin-inline: auto;
      padding: 10px 13px;
      font-size: 12px;
      white-space: normal;
    }

    .hero-tagline {
      margin-top: 18px;
      font-size: 13px;
    }

    .location {
      margin-top: 13px;
      font-size: 12px;
    }

    .status-card {
      width: min(320px, 100%);
      min-height: 0;
      margin: 0 auto;
      padding: 16px;
      text-align: left;
      font-size: 12px;
    }

    .status-prompt {
      font-size: 18px;
    }

    .status-skull {
      font-size: 18px;
    }

    .home-nav {
      min-height: 54px;
      padding: 0 14px;
    }

    .home-nav-links {
      gap: 18px;
    }

    .home-nav a {
      font-size: 10px;
    }

    .home-nav-status {
      display: none;
    }

    .dashboard {
      padding: 18px;
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .window {
      border-width: 2px;
      border-radius: 9px;
      box-shadow: 4px 5px 0 #111;
    }

    .window-title {
      min-height: 42px;
      padding: 9px 12px;
      border-bottom-width: 2px;
      font-size: 13px;
    }

    .window-subtitle {
      padding: 10px 13px 7px;
      font-size: 11px;
    }

    .case-list {
      padding: 8px 10px 0;
    }

    .case-card {
      min-height: 0;
      padding: 12px;
      grid-template-columns: 1fr;
      gap: 12px;
      margin-bottom: 10px;
      border-width: 1px;
      border-radius: 8px;
    }

    .case-card > img {
      width: 100%;
      height: 180px;
      border-radius: 7px;
    }

    .case-body {
      padding-bottom: 24px;
    }

    .tags {
      gap: 5px;
    }

    .tags span {
      padding: 4px 7px;
      font-size: 9px;
    }

    time {
      font-size: 10px;
    }

    .case-card h2 {
      margin: 12px 0 7px;
      font-size: 20px;
    }

    .case-card p {
      font-size: 12px;
    }

    .case-arrow {
      font-size: 22px;
    }

    .view-all {
      padding: 8px 15px 14px;
      font-size: 12px;
    }

    .sidebar {
      gap: 16px;
    }

    .about-grid {
      padding: 12px;
      grid-template-columns: 110px 1fr;
      gap: 12px;
    }

    .about-grid img {
      width: 110px;
      height: 150px;
      border-width: 1px;
      border-radius: 7px;
    }

    .about-grid p {
      font-size: 11px;
    }

    .panel-link {
      padding: 3px 12px 12px;
      font-size: 11px;
    }

    .mission-terminal {
      margin: 12px;
      padding: 12px 14px;
      font-size: 11px;
    }

    .connect-links {
      padding: 5px 12px 10px;
    }

    .connect-links a {
      padding: 9px 0;
      font-size: 11px;
    }
  }
</style>
